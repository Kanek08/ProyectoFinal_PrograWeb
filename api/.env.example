# Copie este archivo como .env y llene los valores. El .env NUNCA se sube al repositorio (S2).
PORT=3000

# La misma base que usa el panel Laravel (laravel/.env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_computadoras
DB_USER=crm
DB_PASSWORD=

# Al menos 32 caracteres aleatorios. Genérelo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen EXACTO de la SPA (S6). Nunca *.
CORS_ORIGIN=http://127.0.0.1:5500
